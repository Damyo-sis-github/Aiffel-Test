# 이 파일을 .env 로 복사해 채우십시오. .env 는 절대 커밋되지 않습니다 (#17).
# Windows 에서는 파일 속성으로, WSL/Linux 에서는 chmod 600 으로 권한을 제한하십시오.
#
# 이 값들은 로그·리포트·커밋·예외 메시지 어디에도 출력되지 않습니다.
# 출력되는 코드가 있다면 그건 버그입니다.

# ── 알림 (§11.6) ───────────────────────────────────────────────
# 텔레그램 1차: @BotFather 로 봇 생성 → 토큰, 봇과 대화 후 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 카카오톡 2차 "나에게 보내기" (§17 결정 대기: Kakao Developers 앱 + 토큰)
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# ── 데이터 (§4.1) ──────────────────────────────────────────────
# FRED (매크로·환율). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 한국은행 ECOS (선택)
ECOS_API_KEY=

# 토스증권 Open API — **읽기 전용 스코프만** 신청하십시오 (§4.1).
# 발급 전에는 config/runtime.yaml 의 toss.enabled 를 false 로 둡니다.
TOSS_API_KEY=
TOSS_API_SECRET=

# ── 개발 전용 (실운영에서 켜지 마십시오) ────────────────────────
# QUANT_GUARD_BYPASS=1        # 기기·네트워크·경로 가드 우회. 리포트에 배너가 박힙니다.
# QUANT_CLOCK_DRIFT_OVERRIDE= # 시계 오차 주입 (테스트용)
